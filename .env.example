BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_MAX_BODY_BYTES=65536
# 上传端点（/api/eda 等）单文件体积上限；上传路径前缀白名单见 BACKEND_UPLOAD_PATHS。
BACKEND_UPLOAD_MAX_BYTES=20971520
BACKEND_UPLOAD_PATHS=/api/eda
BACKEND_CACHE_TTL_SECONDS=60
BACKEND_RATE_LIMIT_REQUESTS=180
BACKEND_RATE_LIMIT_WINDOW_SECONDS=60
# 后端状态数据库路径（留空 = data/backend_state.db）
BACKEND_STATE_DB=
# 后端启动后立即在进程内触发一次每日数据更新（0=关 1=开）
BACKEND_AUTO_REFRESH=0
# 政策雷达进程内定时刷新间隔秒数（0=关闭定时刷新）
BACKEND_POLICY_INTERVAL_SECONDS=0
# 可选简单鉴权：留空保持演示开放；设置后 /api/* 需 Authorization: Bearer <key>
BACKEND_API_KEY=
BACKEND_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

API_BASE_URL=http://127.0.0.1:8000

# 四脑分析 AI 接入：FOUR_BRAIN_AI=1 后，/api/four-brain 优先调用大模型，
# 未配置密钥或单脑调用失败时自动回退到规则引擎。
FOUR_BRAIN_AI=1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=120
# AI 调用超时/瞬时失败自动重试次数（1 = 失败后重试一次；0 = 不重试）
AI_RETRIES=1
# AI 专用代理 URL（不要以 _proxy 结尾命名，避免被 requests 误当作系统代理）
AI_PROXY_URL=
AI_NO_PROXY_FLAG=0
# 四脑分析整体超时（秒）：worker 超时自动重建并结构化降级，防止整次分析卡死。
FOUR_BRAIN_WORKER_TIMEOUT=420
FOUR_BRAIN_WORKER_MAX_TASKS=20

# 贸易决策 Demo（Node server.js）AI 接入：可复用上面的 OPENAI_*，
# 也可用 AI_BASE_URL / AI_API_KEY / AI_MODEL 单独指定 OpenAI 兼容服务。
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=12000

# AI 自主获取数据：SEARCH_PROVIDER 支持 crawler、mock、duckduckgo、duckduckgo_html、tavily、serpapi、generic
# duckduckgo_html 免 Key 网页搜索优先，失败自动回退 mock；crawler 为 Wikimedia 公开爬虫（无需 Key）
SEARCH_PROVIDER=duckduckgo_html
SEARCH_API_KEY=
SEARCH_API_URL=
SEARCH_MAX_RESULTS=5
SEARCH_RESULT_CACHE_TTL=300
# 单次联网搜索超时（毫秒）：防止某个搜索源长时间无响应
SEARCH_TIMEOUT_MS=30000
# 本地代理（Clash 等）：Node 侧访问 DeepSeek/OpenAI/DuckDuckGo 需要走代理时填写，例如 http://127.0.0.1:7897
SEARCH_PROXY_URL=
AI_MAX_TOOL_STEPS=5

# 真实数据源（无 Key 默认可跑，有 Key 自动升级；失败均回退 mock）
# Google Trends：默认开启，每市场最多取前 N 个品类真实数据，其余标 mock
GOOGLE_TRENDS_ENABLED=1
GOOGLE_TRENDS_MAX_KEYWORDS=10
GOOGLE_TRENDS_PROXIES=
GOOGLE_TRENDS_COOKIE=
# 平台榜单 provider 顺序：amazon_github / ebay_github 使用 GitHub 免费样例；amazon_bestsellers 无 Key best-effort；keepa/ebay 需 Key 可选
PLATFORM_RANKING_PROVIDERS=amazon_github,ebay_github,mock
KEEPA_API_KEY=
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
# UN Comtrade 订阅 Key（可选；未配置时使用免 Key preview 接口）
COMTRADE_SUBSCRIPTION_KEY=
# Open Food Facts 开放商品数据库（免 Key，ODbL；失败自动回退 mock）
OPEN_FOOD_FACTS_ENABLED=1
OPEN_FOOD_FACTS_MAX_PRODUCTS=20

# 政策雷达官方源（仅官方原文进入决策链；失败保留上次已验证快照）
POLICY_SOURCES=gov_cn,federal_register,eu,uk
POLICY_WATCH_INTERVAL_HOURS=6
POLICY_WATCH_LOOKBACK_DAYS=14

# 货源/供应商尽调：1688-cli 为 MIT 外部 CLI，需先 `npm i -g 1688-cli` 并扫码登录；
# 未安装/未登录/超时自动回退 mock。SUPPLIER_CLI_PATH 可指定可执行文件完整路径。
SUPPLIER_SOURCE_PROVIDERS=1688_cli,mock
SUPPLIER_CLI_PATH=
SUPPLIER_CLI_TIMEOUT_SECONDS=90
SUPPLIER_MAX_KEYWORDS=10
# ===== 前后端联通环境（根 .env 同时驱动后端与前端） =====
# 后端：BACKEND_HOST / BACKEND_PORT / BACKEND_ALLOWED_ORIGINS 控制监听地址与跨域（见上）。
#       scripts/run_api.py 与 src/config.py 会自动加载本文件（python-dotenv，缺失时回退默认值）。
# 前端：frontend/vite.config.ts 将 Vite envDir 指向项目根，仅 VITE_* 前缀变量会注入客户端代码
#       （如 frontend/src/shared/api/client.ts 读取的 VITE_API_BASE）。
#   VITE_API_BASE：前端请求后端 API 的完整 URL；留空 = 同源（生产 /app 部署保持留空，
#                  后端在 /app 同源托管构建产物 output/app，无需跨域）。
VITE_API_BASE=
#   VITE_PROXY_TARGET：pnpm dev（Vite 5173）时 /api 与 /output 的代理目标；
#                      前后端分离开发时指向后端地址，默认 http://127.0.0.1:8000。
VITE_PROXY_TARGET=http://127.0.0.1:8000
